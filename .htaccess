# Apache Configuration for Smart Online Enrollment System

# Enable error reporting (disable in production)
# php_flag display_errors On
# php_value error_reporting E_ALL

# Set default charset
AddDefaultCharset UTF-8

# Set directory index files
DirectoryIndex index.php index.html

# Enable PHP processing
<IfModule mod_php7.c>
    php_flag short_open_tag Off
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Prevent directory listing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Enable URL rewriting (if mod_rewrite is available)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Redirect to HTTPS (uncomment for production with SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # If the request is for a directory, append trailing slash
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ $1/ [L,R=301]
</IfModule>

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect schema.sql from direct access
<Files "schema.sql">
    Order allow,deny
    Deny from all
</Files>

# Protect db_connection.php from direct access (allow PHP includes)
<Files "db_connection.php">
    Order allow,deny
    Deny from all
    Allow from 127.0.0.1
    Allow from ::1
</Files>

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Set proper MIME types
<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/css css
    AddType text/html html htm
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control for static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>

# Error pages (optional - create these files if needed)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php
